# Preferred local setup: set the components below and let the backend build the
# password-based connection URL. DATABASE_URL can be used as an explicit override.
# DATABASE_URL=postgresql+psycopg://dotty_app:replace-with-url-encoded-password@127.0.0.1:5432/dotty_tutor
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=dotty_app
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=dotty_tutor
# POSTGRES_SSLMODE=require
DOTTY_DATA_DIR=./data
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Set this in production, for example: tutor.example.com
TRUSTED_HOSTS=

MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MINERU_COMMAND=
REVIEW_PROVIDER=ollama
REVIEW_MODEL=qwen2.5:7b
VISION_PROVIDER=codex
VISION_MODEL=default

TTS_PROVIDER=auto
QWEN_TTS_URL=http://127.0.0.1:8020
QWEN_TTS_WARMUP_ENABLED=1
QWEN_TTS_WARMUP_TEXT=你好。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural
