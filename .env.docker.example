# Use a long URL-safe value because Compose also embeds it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=dotty
POSTGRES_DB=dotty_tutor
POSTGRES_HOST_PORT=15432

# Structured API logs: INFO in production, DEBUG only while troubleshooting.
LOG_LEVEL=INFO

# 基础 Docker API 不包含本机的 MinerU；留空时 UI 会明确显示 Docker 边界。
# 推荐使用 MinerU Precision Extract API，Token 只放在部署平台的 Secret 中。
MINERU_COMMAND=
MINERU_API_URL=https://mineru.net
MINERU_API_KEY=
MINERU_API_MODEL=vlm
MINERU_API_TIMEOUT_SECONDS=900
MINERU_API_POLL_INTERVAL_SECONDS=3

# Structured API logs: INFO in production, DEBUG only while troubleshooting.
LOG_LEVEL=INFO

WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
PUBLIC_PROTECTION_ENABLED=true
PUBLIC_RATE_LIMIT_REQUESTS=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_MODEL_RATE_LIMIT_REQUESTS=6
PUBLIC_MODEL_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_MODEL_DAILY_LIMIT=60
PUBLIC_MODEL_CONCURRENCY=2
PUBLIC_MAX_REQUEST_BYTES=12582912

# The base Compose stack runs without external model services.
MODEL_PROVIDER=mock
MODEL_NAME=static-demo
REVIEW_PROVIDER=mock
REVIEW_MODEL=static-demo

# DeepSeek is optional. Keep the key only in the deployment platform Secret.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-flash

# To use Ollama/Qwen on the Docker host, keep host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
TTS_PROVIDER=auto
QWEN_TTS_URL=http://host.docker.internal:8020

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural
