# 本机开发配置：FastAPI、React、MinerU、Qwen3-TTS 和 Codex 在宿主机运行。
# PostgreSQL 仍由 docker compose 提供，默认映射到 127.0.0.1:15432。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_HOST_PORT=15432
POSTGRES_USER=dotty
# Replace this with the same password used in .env.
POSTGRES_PASSWORD=replace-with-the-same-password-from-dot-env
POSTGRES_DB=dotty_tutor

# DOTTY_DATA_DIR 只选择上传和生成文件目录，数据库仍使用上面的 PostgreSQL。
# 数据文件默认保存在仓库的 data/；跨 worktree 复用已有上传时填写原目录绝对路径。
# DOTTY_DATA_DIR=./data
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
TRUSTED_HOSTS=localhost,127.0.0.1

# 本机 ChatGPT/Codex 登录态由宿主机 Codex CLI 使用。
MODEL_PROVIDER=codex
MODEL_NAME=default
# 陪练独立使用此配置，不会改变教材生成和审核模型。
TUTOR_MODEL_PROVIDER=codex
TUTOR_MODEL_NAME=gpt-5.6-sol
REVIEW_PROVIDER=codex
REVIEW_MODEL=gpt-5.6-sol

# 本机工具和服务。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# MinerU 在当前仓库根目录 .mineru-venv 或 PATH 时可留空；安装在其他目录时填可执行文件绝对路径。
MINERU_COMMAND=
TTS_PROVIDER=qwen
QWEN_TTS_URL=http://127.0.0.1:8020
# 若 Qwen3-TTS 独立虚拟环境位于当前仓库外，填写其中 python 的绝对路径；留空则使用仓库根目录 .qwen3-tts-venv。
QWEN_TTS_PYTHON=
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_DEVICE=auto
# 启动时执行一次短文本推理，避免学生第一次播放承担设备内核初始化开销。
QWEN_TTS_WARMUP_ENABLED=1
QWEN_TTS_WARMUP_TEXT=你好。

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural

# 可选云端 Runtime；密钥仅由 API/Worker 读取，留空保持现有本机选择。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-flash
MINERU_API_URL=https://mineru.net
MINERU_API_KEY=
MINERU_API_MODEL=vlm
MINERU_API_TIMEOUT_SECONDS=900
MINERU_API_POLL_INTERVAL_SECONDS=3
