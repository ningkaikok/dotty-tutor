{
  "name": "dotty-tutor",
  "private": true,
  "version": "0.21.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "generate:api": "node scripts/generate-api-types.mjs",
